{
  "name": "visual-form-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "build:packages": "npm run build --workspace @visual-form-builder/form-schema --workspace @visual-form-builder/form-renderer --workspace @visual-form-builder/contracts --workspace @visual-form-builder/test-fixtures",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces",
    "check": "npm run check:runtime && npm run typecheck",
    "dev": "npm run check:runtime && concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @visual-form-builder/api",
    "dev:web": "npm run dev --workspace @visual-form-builder/web",
    "build": "npm run check:runtime && npm run build:packages && npm run build --workspace @visual-form-builder/api && npm run build --workspace @visual-form-builder/web",
    "start": "npm run check:runtime && concurrently --kill-others --names api,web \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm run start --workspace @visual-form-builder/api",
    "start:web": "npm run start --workspace @visual-form-builder/web",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "concurrently": "10.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
