# Local development only. Copy once to .env; keep that private file out of Git.
# These non-secret defaults start the existing shell/API and local Mongo replica set.
COMPOSE_PROJECT_NAME=visual-form-builder-local
PORT=3000
API_PORT=4000
MONGO_PORT=27019
MONGODB_REPLICA_SET=vfb-rs
# Keep the URI port equal to MONGO_PORT. Quotes protect & when sourcing in Bash.
MONGODB_URI='mongodb://127.0.0.1:27019/visual_form_builder?replicaSet=vfb-rs&directConnection=true'
